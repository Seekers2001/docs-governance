{
  "openapi": "3.1.0",
  "info": {
    "title": "订单接口示例契约",
    "version": "0.1.0"
  },
  "paths": {
    "/api/orders/{id}": {
      "get": {
        "operationId": "getOrder",
        "summary": "查单个订单",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/OrderId"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Order"
                }
              }
            }
          },
          "401": {
            "description": "未登录或 token 失效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "订单不存在",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "OrderId": {
        "type": "string",
        "pattern": "^[0-9]{19}$",
        "description": "19 位 ID，以字符串传输"
      },
      "Money": {
        "type": "number",
        "multipleOf": 0.01,
        "description": "单位元，精确到分"
      },
      "Order": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "orderId",
          "userName",
          "amount",
          "status",
          "createdAt",
          "items"
        ],
        "properties": {
          "orderId": {
            "$ref": "#/components/schemas/OrderId"
          },
          "userName": {
            "type": "string"
          },
          "amount": {
            "$ref": "#/components/schemas/Money"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "paid",
              "shipped",
              "done",
              "refunded"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrderItem"
            }
          }
        }
      },
      "OrderItem": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "skuId",
          "title",
          "price",
          "quantity"
        ],
        "properties": {
          "skuId": {
            "$ref": "#/components/schemas/OrderId"
          },
          "title": {
            "type": "string"
          },
          "price": {
            "$ref": "#/components/schemas/Money"
          },
          "quantity": {
            "type": "integer"
          }
        }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "ORDER_NOT_FOUND",
                  "UNAUTHORIZED"
                ]
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
